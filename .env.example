# Appwrite Configuration
# Get these values from your Appwrite Console: https://cloud.appwrite.io/console

# Your Appwrite endpoint (usually https://cloud.appwrite.io/v1)
NEXT_PUBLIC_APPWRITE_HOST_URL=https://cloud.appwrite.io/v1

# Your Appwrite project ID (found in your project settings)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here

# Your Appwrite API key (create one in Settings > API Keys with appropriate scopes)
APPWRITE_API_KEY=your_api_key_here
